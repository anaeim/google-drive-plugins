# ──────────────────────────────────────────────────────────────────
# Google Drive Connector — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────

# Your Google account email (used for logging only)
GOOGLE_ACCOUNT_EMAIL=your-email@gmail.com

# OAuth2 credentials — copy from credentials.json downloaded from
# https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# Redirect URI for the local OAuth flow (leave as-is)
GOOGLE_REDIRECT_URI=http://localhost:8080/

# File paths (relative to project root)
CREDENTIALS_FILE=credentials.json
TOKEN_FILE=token.json

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
